# ---------------------------------------------------------------------------
# Uniclyst — environment variables. Copy to .env and fill in real values.
# NEVER commit a real .env or real keys.
# ---------------------------------------------------------------------------

# Database — PostgreSQL in production / Docker; SQLite works for local dev.
#   PostgreSQL: postgresql+psycopg://uniclyst:uniclyst@localhost:5432/uniclyst
#   SQLite:     sqlite:///backend/uniclyst.db   (default when unset)
DATABASE_URL=postgresql+psycopg://uniclyst:CHANGE_ME@localhost:5432/uniclyst

