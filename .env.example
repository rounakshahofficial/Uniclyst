# AUTO_CREATE_TABLES/AUTO_SEED=1 is convenient for dev & demos; set to 0 in
# production and run `alembic upgrade head` + `python -m app.db.seed` instead.
>>>>>>> ed8fc0d44e0ce0f77ef9b664831c8d4dfa914647
AUTO_CREATE_TABLES=1
AUTO_SEED=1
# Password for the documented demo seed accounts (aarav, meera, rohan, student, reviewer)
DEMO_PASSWORD=demo123

# ---------------------------------------------------------------------------
# TinyFish web intelligence (Community Scout). Optional at runtime:
# without a key the app runs in clearly-labelled DEMO MODE with seeded
# discovery data. Get a key at https://agent.tinyfish.ai/api-keys
# The key is used ONLY on the backend — never shipped to the browser.
# ---------------------------------------------------------------------------
TINYFISH_API_KEY=
TINYFISH_TIMEOUT_SECONDS=30
TINYFISH_MAX_RETRIES=2
TINYFISH_CACHE_TTL_SECONDS=3600
